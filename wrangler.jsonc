{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokepixel-mauricio",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "STORE",
      "id": "b43865fff36b42e193da5fdf05f9159b"
    }
  ]
}
